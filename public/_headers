# Cross-origin isolation enables SharedArrayBuffer, required for multi-threaded
# WASM in jSquash's *_mt encoders (AVIF/JXL). Without these the app falls back
# to single-threaded codecs, which still works but is 2-4× slower.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY

# WASM must be served with the correct MIME for streaming compile + COEP.
# Every .wasm Vite emits lives under /assets/ with a content hash, so its
# year-long Cache-Control comes from the rule below — repeating it here made
# Cloudflare send the header twice.
/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
