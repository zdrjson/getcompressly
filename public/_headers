# Cross-origin isolation enables SharedArrayBuffer, required for multi-threaded
# WASM in jSquash's *_mt encoders (AVIF/JXL). Without these the app falls back
# to single-threaded codecs, which still works but is 2-4× slower.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY

# WASM must be served with the correct MIME for streaming compile + COEP.
# Content-hashed, so it is safe to cache at the edge for a year.
/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
